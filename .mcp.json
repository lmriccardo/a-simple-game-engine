{
  "mcpServers": {
    "agentmemory": {
      "command": "wsl.exe",
      "args": [
        "-d",
        "Ubuntu",
        "--",
        "/home/ricca/.nvm/versions/node/v24.13.0/bin/agentmemory",
        "mcp",
        "--tools",
        "core"
      ],
      "env": {
        "AGENTMEMORY_URL": "http://localhost:3111"
      }
    },
    "graphify": {
      "type": "stdio",
      "command": "graphify-mcp",
      "args": [
        "./graphify-out/graph.json"
      ],
      "env": {}
    }
  }
}