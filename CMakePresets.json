{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows",
            "displayName": "Windows (dev: tests + examples)",
            "description": "Matches the day-to-day local dev loop: Ninja Multi-Config generator (run from a VS Developer shell), tests and examples both built.",
            "inherits": "windows-base",
            "cacheVariables": {
                "BUILD_TESTING": "ON",
                "ASGE_BUILD_EXAMPLES": "ON",
                "ASGE_BUILD_EDITOR": "OFF"
            }
        },
        {
            "name": "windows-ci",
            "displayName": "Windows (CI parity)",
            "description": "Mirrors the Windows job in .github/workflows/ctest.yml exactly (examples off, tests on).",
            "inherits": "windows-base",
            "cacheVariables": {
                "BUILD_TESTING": "ON",
                "ASGE_BUILD_EXAMPLES": "OFF"
            }
        },
        {
            "name": "windows-editor",
            "displayName": "Windows (editor: tests, no examples)",
            "description": "For iterating on asge-editor without paying for every examples/ demo to rebuild -- tests stay on.",
            "inherits": "windows-base",
            "cacheVariables": {
                "BUILD_TESTING": "ON",
                "ASGE_BUILD_EXAMPLES": "OFF",
                "ASGE_BUILD_EDITOR": "ON"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux",
            "displayName": "Linux (dev: tests + examples)",
            "description": "Single-config generator, so CMAKE_BUILD_TYPE is fixed to Debug here for the local dev loop.",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTING": "ON",
                "ASGE_BUILD_EXAMPLES": "ON",
                "ASGE_BUILD_EDITOR": "OFF"
            }
        },
        {
            "name": "linux-ci",
            "displayName": "Linux (CI parity)",
            "description": "Mirrors the Linux job in .github/workflows/ctest.yml exactly (no explicit CMAKE_BUILD_TYPE, examples off).",
            "inherits": "linux-base",
            "cacheVariables": {
                "BUILD_TESTING": "ON",
                "ASGE_BUILD_EXAMPLES": "OFF"
            }
        },
        {
            "name": "linux-editor",
            "displayName": "Linux (editor: tests, no examples)",
            "description": "For iterating on asge-editor without paying for every examples/ demo to rebuild -- tests stay on.",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTING": "ON",
                "ASGE_BUILD_EXAMPLES": "OFF",
                "ASGE_BUILD_EDITOR": "ON"
            }
        },
        {
            "name": "linux-package",
            "displayName": "Linux (package)",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_TESTING": "OFF",
                "ASGE_BUILD_EXAMPLES": "OFF",
                "ASGE_INSTALL": "ON"
            }
        },
        {
            "name": "windows-package",
            "displayName": "Windows (package)",
            "inherits": "windows-base",
            "cacheVariables": {
                "BUILD_TESTING": "OFF",
                "ASGE_BUILD_EXAMPLES": "OFF",
                "ASGE_INSTALL": "ON"
            }
        },
        {
            "name": "macos-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "macos",
            "displayName": "macOS (dev: tests + examples)",
            "description": "Single-config generator, so CMAKE_BUILD_TYPE is fixed to Debug here for the local dev loop.",
            "inherits": "macos-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SDL3_DIR": "/opt/homebrew/lib/cmake/SDL3",
                "BUILD_TESTING": "ON",
                "ASGE_BUILD_EXAMPLES": "ON",
                "ASGE_BUILD_EDITOR": "OFF"
            }
        },
        {
            "name": "macos-ci",
            "displayName": "macOS (CI parity)",
            "description": "Mirrors a macOS CI job exactly (no explicit CMAKE_BUILD_TYPE, examples off).",
            "inherits": "macos-base",
            "cacheVariables": {
                "SDL3_DIR": "/opt/homebrew/lib/cmake/SDL3",
                "BUILD_TESTING": "ON",
                "ASGE_BUILD_EXAMPLES": "OFF"
            }
        },
        {
            "name": "macos-editor",
            "displayName": "macOS (editor: tests, no examples)",
            "description": "For iterating on asge-editor without paying for every examples/ demo to rebuild -- tests stay on.",
            "inherits": "macos-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SDL3_DIR": "/opt/homebrew/lib/cmake/SDL3",
                "BUILD_TESTING": "ON",
                "ASGE_BUILD_EXAMPLES": "OFF",
                "ASGE_BUILD_EDITOR": "ON"
            }
        },
        {
            "name": "macos-package",
            "displayName": "macOS (package)",
            "inherits": "macos-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "SDL3_DIR": "/opt/homebrew/lib/cmake/SDL3",
                "BUILD_TESTING": "OFF",
                "ASGE_BUILD_EXAMPLES": "OFF",
                "ASGE_INSTALL": "ON"
            }
        },
        {
            "name": "windows-bench",
            "displayName": "Windows (benchmarks, Release)",
            "description": "Optimized build of benchmarks/ only (no tests, examples or editor), in its own build/bench directory so the Debug dev tree is left alone.",
            "inherits": "windows-base",
            "binaryDir": "${sourceDir}/build/bench",
            "cacheVariables": {
                "BUILD_TESTING": "OFF",
                "ASGE_BUILD_EXAMPLES": "OFF",
                "ASGE_BUILD_EDITOR": "OFF",
                "ASGE_BUILD_BENCHMARKS": "ON"
            }
        },
        {
            "name": "linux-bench",
            "displayName": "Linux (benchmarks, Release)",
            "description": "Optimized build of benchmarks/ only (no tests, examples or editor), in its own build/bench directory so the Debug dev tree is left alone.",
            "inherits": "linux-base",
            "binaryDir": "${sourceDir}/build/bench",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_TESTING": "OFF",
                "ASGE_BUILD_EXAMPLES": "OFF",
                "ASGE_BUILD_EDITOR": "OFF",
                "ASGE_BUILD_BENCHMARKS": "ON"
            }
        },
        {
            "name": "macos-bench",
            "displayName": "macOS (benchmarks, Release)",
            "description": "Optimized build of benchmarks/ only (no tests, examples or editor), in its own build/bench directory so the Debug dev tree is left alone.",
            "inherits": "macos-base",
            "binaryDir": "${sourceDir}/build/bench",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "SDL3_DIR": "/opt/homebrew/lib/cmake/SDL3",
                "BUILD_TESTING": "OFF",
                "ASGE_BUILD_EXAMPLES": "OFF",
                "ASGE_BUILD_EDITOR": "OFF",
                "ASGE_BUILD_BENCHMARKS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-debug",
            "configurePreset": "windows",
            "configuration": "Debug"
        },
        {
            "name": "windows-release",
            "configurePreset": "windows",
            "configuration": "Release"
        },
        {
            "name": "windows-ci-debug",
            "configurePreset": "windows-ci",
            "configuration": "Debug"
        },
        {
            "name": "windows-editor-debug",
            "configurePreset": "windows-editor",
            "configuration": "Debug"
        },
        {
            "name": "linux",
            "configurePreset": "linux"
        },
        {
            "name": "linux-ci",
            "configurePreset": "linux-ci"
        },
        {
            "name": "linux-editor",
            "configurePreset": "linux-editor"
        },
        {
            "name": "linux-package",
            "configurePreset": "linux-package"
        },
        {
            "name": "windows-package",
            "configurePreset": "windows-package",
            "configuration": "Release"
        },
        {
            "name": "macos",
            "configurePreset": "macos"
        },
        {
            "name": "macos-ci",
            "configurePreset": "macos-ci"
        },
        {
            "name": "macos-editor",
            "configurePreset": "macos-editor"
        },
        {
            "name": "macos-package",
            "configurePreset": "macos-package"
        },
        {
            "name": "windows-bench",
            "configurePreset": "windows-bench",
            "configuration": "Release"
        },
        {
            "name": "linux-bench",
            "configurePreset": "linux-bench"
        },
        {
            "name": "macos-bench",
            "configurePreset": "macos-bench"
        }
    ],
    "testPresets": [
        {
            "name": "windows-debug",
            "configurePreset": "windows",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-ci-debug",
            "configurePreset": "windows-ci",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-editor-debug",
            "configurePreset": "windows-editor",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux",
            "configurePreset": "linux",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-ci",
            "configurePreset": "linux-ci",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-editor",
            "configurePreset": "linux-editor",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "macos",
            "configurePreset": "macos",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "macos-ci",
            "configurePreset": "macos-ci",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "macos-editor",
            "configurePreset": "macos-editor",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
