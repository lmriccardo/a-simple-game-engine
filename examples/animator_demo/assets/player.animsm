<?xml version="1.0" encoding="UTF-8"?>
<AnimStateMachine initial="idle">
  <Flags>
    <Flag name="running"/>
  </Flags>
  <Triggers>
    <Trigger name="attack"/>
    <Trigger name="hurt"/>
  </Triggers>
  <Clips>
    <Clip name="idle"/>
    <Clip name="run"/>
    <Clip name="attack"/>
    <Clip name="hurt"/>
  </Clips>

  <State name="idle" clip="idle" end="loop">
    <Transition to="hurt"   trigger="hurt" priority="10"/>
    <Transition to="attack" trigger="attack"/>
    <Transition to="run"    when="running"/>
  </State>

  <State name="run" clip="run" end="loop">
    <Transition to="hurt"   trigger="hurt" priority="10"/>
    <Transition to="attack" trigger="attack"/>
    <Transition to="idle"   when="!running"/>
  </State>

  <State name="attack" clip="attack" end="hold">
    <Transition to="hurt" trigger="hurt" priority="10"/>
    <Transition to="run"  atEnd="true" when="running" priority="1"/>
    <Transition to="idle" atEnd="true"/>
  </State>

  <State name="hurt" clip="hurt" end="hold">
    <Transition to="idle" atEnd="true"/>
  </State>
</AnimStateMachine>
